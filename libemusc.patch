+/*
+ * Free one voice for a new note. A released note is the right one to take: it
+ * is on its way out, and the list is in order, so the first one found is the
+ * oldest and the quietest. With nothing released the oldest note goes, which
+ * is what the hardware's voice assignment does.
+ */
+bool Part::steal_note(void)
+{
+  _notesMutex->lock();
+
+  Note *victim = nullptr;
+  for (auto &n: _notes) {
+    if (n->is_released()) {
+      victim = n;
+      break;
+    }
+  }
+  if (!victim && !_notes.empty())
+    victim = _notes.front();
+
+  if (victim)
+    _notes.remove(victim);
+
+  _notesMutex->unlock();
+
+  if (!victim)
+    return false;
+
+  delete victim;
+  return true;
+}
