+// Build one coefficient row per phase of the rational input/output ratio. At
+// 48 kHz the ratio is 2/3, so only three rows are needed and the per-output
+// row interpolation disappears from the inner loop.
+void Resampler::_buildPhases(int sampleRate)
+{
+  int g = _gcd(32000, sampleRate);
+  _stepNum = 32000 / g;
+  _stepDen = sampleRate / g;
+
+  _phaseCoeffs.clear();
+  if (_stepDen > MAX_PHASES)
+    return;
+
+  _phaseCoeffs.resize(_stepDen * TAPS);
+
+  for (int p = 0; p < _stepDen; ++p) {
+    double frac = static_cast<double>(p) / _stepDen;
+    double phasePos = frac * NPHASE;
+    int pidx = static_cast<int>(phasePos);
+    float pf = static_cast<float>(phasePos - pidx);
+
+    const float *row0 = &_table[pidx       * TAPS];
+    const float *row1 = &_table[(pidx + 1) * TAPS];
+    float *row = &_phaseCoeffs[p * TAPS];
+
+    for (int k = 0; k < TAPS; ++k)
+      row[k] = row0[k] + pf * (row1[k] - row0[k]);
+  }
+}
+
+
+int Resampler::_gcd(int a, int b)
+{
+  while (b) {
+    int t = a % b;
+    a = b;
+    b = t;
+  }
+
+  return a;
+}
+
+
