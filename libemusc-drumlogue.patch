     _chorus(NULL),
     _reverb(NULL)
 {
+#ifndef EMUSC_NO_CHORUS
   _chorus = new Chorus(settings);
+#endif
+#ifndef EMUSC_NO_REVERB
   _reverb = new Reverb(settings);
+#endif
 
   update();
 }
@@ -62,15 +66,27 @@ int SystemEffects::apply(std::array<std::array<float, 256>, 2> &chorusBus,
 
   for (int i = 0; i < 256; i ++) {
     float cSample[2] = { 0, 0 };
+#ifndef EMUSC_NO_CHORUS
     float cInput = 0.5f * (chorusBus[0][i] + chorusBus[1][i]);
     _chorus->process_sample(cInput, cSample, &cReverbSend);
+#else
+    (void) chorusBus;
+    cReverbSend = 0;
+#endif
 
     chorusOut[0][i] = cSample[0];
     chorusOut[1][i] = cSample[1];
 
     float rSample[2] = { 0, 0 };
+#ifndef EMUSC_NO_REVERB
+    // For hosts with a reverb of their own: the reverb network is the most
+    // expensive part of the system effects, and the bus is still summed.
     float rInput = 0.5f * (reverbBus[0][i] + reverbBus[1][i]) + cReverbSend;
     _reverb->process_sample(rInput, rSample);
+#else
+    (void) reverbBus;
+    (void) cReverbSend;
+#endif
 
     reverbOut[0][i] = rSample[0];
     reverbOut[1][i] = rSample[1];
